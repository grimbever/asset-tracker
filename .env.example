# Copy to .env.local. Leave these blank to run the setup screen.
# The app talks to Supabase only when the URL and one key are set.
# A pasted URL may end in /rest/v1; the app strips that before creating the client.
# Use the new publishable key (sb_publishable_...) or a legacy anon JWT. Either name works.
# If both keys are set, the publishable key is used.

# Optional. Used for auth email links. In the browser, the current origin is used when this is empty.
# Set this on the production Vercel project. Leave it empty on preview deployments.
NEXT_PUBLIC_SITE_URL=

# Project URL from Supabase. https://your-project.supabase.co is ideal.
# your-project.supabase.co and a trailing /rest/v1 are accepted. A key pasted here is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Check-out, check-in, flagged status emails, invites, and subscription reminders.
# Leave blank to skip email without an error.
# NOTIFY_FROM must be a sender on a domain you verified in Resend, such as Asset Tracker <assets@yourdomain.com>.
RESEND_API_KEY=
NOTIFY_FROM=

# Optional. The daily subscription reminder job uses this to read every organization.
# Leave blank and the job skips without an error. Do not use a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Vercel Cron sends this as Authorization: Bearer <secret>.
# Leave blank and the reminder route does no work.
CRON_SECRET=
